## .NET gitignore — https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet Packages
*.nupkg
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# Build output
build_out/
code_sign/
codesign.zip

# Roslyn / language-server "lightweight solution" cache (per-project, machine-local)
*.lscache

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Claude Code local settings (user-specific allowlists, do not commit)
.claude/

# Internal working docs / prompts — MUST NOT be published to this public repo.
docs/
assets/clone-to-new-product.md
assets/mcp-verifycation.md
assets/mcp-tests-verification.md
assets/mcp-products.md
assets/improvement,md
assets/2026-*.md
