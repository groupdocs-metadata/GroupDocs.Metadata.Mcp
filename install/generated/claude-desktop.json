{
  "mcpServers": {
    "groupdocs-metadata": {
      "type": "stdio",
      "command": "dnx",
      "args": ["GroupDocs.Metadata.Mcp", "--yes"],
      "env": {
        "GROUPDOCS_MCP_STORAGE_PATH": "/path/to/documents",
        "GROUPDOCS_LICENSE_PATH": "/path/to/GroupDocs.Total.lic"
      }
    }
  }
}
