<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>GroupDocs.Metadata.Mcp</PackageId>
    <Version>$(GroupDocsMetadataMcp)</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>MCP server exposing GroupDocs.Metadata for .NET — read, write, and remove metadata properties from documents, images, and media files via AI agents.</Description>
    <PackageTags>groupdocs;metadata;mcp;model-context-protocol;mcp-server;dotnet-tool;ai;document-metadata</PackageTags>
    <PackageIcon>images\icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <!-- Package as a .NET tool so the nupkg gets the required tools/ layout
         for `dnx` / `dotnet tool install` invocation. -->
    <PackAsTool>true</PackAsTool>
    <!-- Mark as MCP server for NuGet.org discovery (packagetype=McpServer filter).
         NOTE: correct MSBuild property is singular <PackageType>; the plural form is ignored. -->
    <PackageType>McpServer</PackageType>
    <!-- CLI tool name for dnx / dotnet tool install invocation -->
    <ToolCommandName>groupdocs-metadata-mcp</ToolCommandName>
  </PropertyGroup>

  <!-- Keep the packed tools/ layout under NuGet.org's 250 MB hard limit.
       Engine 26.11 pulls GroupDocs.CrossPlatform.NativeAssets (Aspose.Slides
       drawing natives for PPTX/PPT) on top of multi-RID SkiaSharp — a full
       publish lands ~307 MB and fails publish with HTTP 413. Two post-Publish
       deletes bring the nupkg back under the ceiling:

       1. Native PDBs (libSkiaSharp.pdb etc.) — useless in production; the
          managed-code PDB is preserved. <CopyDebugSymbolFilesFromPackages>
          does NOT cover runtimes/<rid>/native/*.pdb.
       2. Exotic / rarely-used RID folders that agents don't run on (musl,
          loongarch, riscv, 32-bit linux) plus the 32-bit Windows Slides
          native. Kept RIDs: win(+x64/arm64), linux(+x64/arm64), osx(+x64/arm64). -->
  <Target Name="StripNativeRuntimePdbs" AfterTargets="Publish">
    <ItemGroup>
      <_NativeRuntimePdbs Include="$(PublishDir)runtimes/**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(_NativeRuntimePdbs)" />
    <Message
      Text="StripNativeRuntimePdbs: removed @(_NativeRuntimePdbs->Count()) native PDB file(s) from publish output to keep the nupkg under NuGet.org's 250 MB limit."
      Importance="high"
      Condition="@(_NativeRuntimePdbs->Count()) > 0" />
  </Target>

  <Target Name="StripExoticRuntimeRids" AfterTargets="StripNativeRuntimePdbs">
    <ItemGroup>
      <_ExoticRidDirs Include="$(PublishDir)runtimes\linux-musl-arm" />
      <_ExoticRidDirs Include="$(PublishDir)runtimes\linux-musl-arm64" />
      <_ExoticRidDirs Include="$(PublishDir)runtimes\linux-musl-loongarch64" />
      <_ExoticRidDirs Include="$(PublishDir)runtimes\linux-musl-riscv64" />
      <_ExoticRidDirs Include="$(PublishDir)runtimes\linux-musl-x64" />
      <_ExoticRidDirs Include="$(PublishDir)runtimes\linux-loongarch64" />
      <_ExoticRidDirs Include="$(PublishDir)runtimes\linux-riscv64" />
      <_ExoticRidDirs Include="$(PublishDir)runtimes\linux-arm" />
      <_ExoticRidDirs Include="$(PublishDir)runtimes\linux-x86" />
      <_ExoticRidDirs Include="$(PublishDir)runtimes\win-x86" />
      <_ExoticRidFiles Include="$(PublishDir)runtimes\win\native\aspose.slides.drawing.capi_vc14x86.dll" />
    </ItemGroup>
    <RemoveDir Directories="@(_ExoticRidDirs)" Condition="Exists('%(_ExoticRidDirs.Identity)')" />
    <Delete Files="@(_ExoticRidFiles)" />
    <Message
      Text="StripExoticRuntimeRids: dropped exotic RID folders + 32-bit Windows Slides native so the nupkg stays under NuGet.org's 250 MB limit."
      Importance="high" />
  </Target>

  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" Visible="false" PackagePath="images\icon.png" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <!-- server.json — read by NuGet.org to generate mcp.json snippets on the package page -->
    <None Include=".mcp\server.json" Pack="true" PackagePath=".mcp/server.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core infrastructure — NuGet packages from groupdocs-mcp-core -->
    <PackageReference Include="GroupDocs.Mcp.Core" Version="$(GroupDocsMcpCore)" />
    <PackageReference Include="GroupDocs.Mcp.Local.Storage" Version="$(GroupDocsMcpCore)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GroupDocs.Metadata" Version="$(GroupDocsMetadata)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsHosting)" />
    <PackageReference Include="ModelContextProtocol" Version="$(ModelContextProtocol)" />
  </ItemGroup>

  <ItemGroup>
    <!-- NOTE (TFM split): the manual SkiaSharp.NativeAssets.Linux.NoDependencies workaround
         was removed after engine 26.6. As of 26.11.0 the GroupDocs.Metadata.Net100 runtime
         (resolved under net10.0) declares SkiaSharp 3.119.2 + NativeAssets.Win32/Linux and
         GroupDocs.CrossPlatform.NativeAssets transitively. The engine pulls the *full*
         NativeAssets.Linux (needs system libfontconfig1), not NoDependencies —
         libfontconfig1 is installed in docker/Dockerfile. -->

    <!-- GroupDocs.Metadata's image-format paths historically P/Invoked System.Drawing.Common
         on Linux; this flag enabled the libgdiplus fallback. The engine now pulls
         System.Drawing.Common 8.0.0 (where this switch is a NO-OP — removed in 7.0+) AND
         Aspose.Drawing (managed GDI+ replacement). Kept as a harmless marker pending CI
         confirmation that Aspose.Drawing covers every image path without libgdiplus. -->
    <RuntimeHostConfigurationOption Include="System.Drawing.EnableUnixSupport" Value="true" />
  </ItemGroup>

</Project>
